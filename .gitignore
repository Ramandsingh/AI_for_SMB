.env
node_modules/
*/node_modules/
frontend/dist/

# Built site artefacts (populated by npm run build, not source-tracked)
sites/ai-smb/*
!sites/ai-smb/.gitkeep
deploy.log
webhook.log

# OpenWolf — session memory files (machine-local, rebuilt each session)
.wolf/memory.md
.wolf/token-ledger.json
.wolf/buglog.json
.wolf/cron-manifest.json
.wolf/cron-state.json
.wolf/designqc-report.json
.wolf/suggestions.json
.wolf/hooks/_session.json
.wolf/anatomy.md

# graphify — generated code map (rebuilt with: npx graphify build .)
graphify-out/
