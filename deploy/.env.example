# ── Site identity ────────────────────────────────────────────────────────────
# Host path — where rsync copies the built frontend files to
SITE_ROOT=/Users/ramanmac/sites/ai-smb/current

# Container path — how nginx-proxy sees the same directory inside Docker
# Matches the right-hand side of the volume mount in nginx-proxy/docker-compose.yml
# e.g. /Users/ramanmac/sites:/srv/sites:ro → NGINX_SITE_ROOT=/srv/sites/ai-smb/current
NGINX_SITE_ROOT=/srv/sites/ai-smb/current

# ── Backend ───────────────────────────────────────────────────────────────────
# Port reserved for this site's backend on the host loopback (127.0.0.1).
# Must be unique across all sites on the same host.
# nginx vhost proxies /api/ → 127.0.0.1:BACKEND_PORT
BACKEND_PORT=3101

# ── Database ──────────────────────────────────────────────────────────────────
DB_ROOT_PASSWORD=change_me_root
DB_USER=ai_smb_user
DB_PASSWORD=change_me_password
DB_NAME=ai_smb_db

# ── Host nginx paths ─────────────────────────────────────────────────────────
# Directory where per-site vhost configs are dropped.
# Linux (Debian/Ubuntu/CentOS):  /etc/nginx/conf.d
# macOS (Homebrew Intel):        /usr/local/etc/nginx/servers
# macOS (Homebrew Apple Silicon):/opt/homebrew/etc/nginx/servers
NGINX_VHOST_DIR=/etc/nginx/conf.d

# Command to reload nginx after installing/updating the vhost config.
# Linux systemd:  sudo systemctl reload nginx
# macOS Homebrew: brew services reload nginx
# Direct:         sudo nginx -s reload
NGINX_RELOAD_CMD="sudo nginx -s reload"

# ── Optional ──────────────────────────────────────────────────────────────────
# LAN IP used by the backend for any host-aware responses
LAN_IP=
