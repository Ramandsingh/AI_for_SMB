# Nginx vhost for ${SITE_DOMAIN}
# Generated by deploy.sh via envsubst — do not edit the installed copy directly.
# Edit deploy/nginx/site.conf.template in the repo instead.

server {
    listen 80;
    server_name _;

    root ${SITE_ROOT};
    index index.html;

    # Allow uploads up to 55 MB (PDF lab 50 MB + overhead)
    client_max_body_size 55m;

    # Proxy API requests to the site's backend container (loopback port)
    location /api/ {
        proxy_pass         http://127.0.0.1:${BACKEND_PORT};
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_read_timeout    120s;
        proxy_send_timeout    120s;
        proxy_connect_timeout 10s;
    }

    # SPA fallback
    location / {
        try_files $uri $uri/ /index.html;
    }
}
