# ai-smb location snippet — auto-generated by deploy.sh via envsubst.
# Do not edit the installed copy directly.
# Edit deploy/nginx/site.conf.template in the repo instead.
#
# Installed to: ${NGINX_VHOST_DIR}/sites/ai-smb.conf

# API — proxied to backend container via Docker DNS (no host port needed)
location /api/ {
    proxy_pass         http://ai-smb-backend:3002;
    proxy_http_version 1.1;
    proxy_set_header   Host              $host;
    proxy_set_header   X-Real-IP         $remote_addr;
    proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_read_timeout    120s;
    proxy_send_timeout    120s;
    proxy_connect_timeout 10s;
}

# SPA — static files served from host-mounted volume
location /ai/ {
    alias ${NGINX_SITE_ROOT}/;
    try_files $uri $uri/ /ai/index.html;
}

# Root redirects to the app
location = / {
    return 301 /ai/;
}
